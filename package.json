{
  "name": "figma-o11-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "harness": "tsx harness/cli.ts",
    "typecheck": "tsc --noEmit",
    "unit": "tsx --test tests/unit/*.test.ts",
    "browser": "playwright test --config tests/playwright.config.ts",
    "test": "npm run typecheck && npm run unit && npm run browser"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.86",
    "@playwright/test": "1.65.1",
    "zod": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "pngjs": "^7.0.0",
    "pixelmatch": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pngjs": "^6",
    "typescript": "~5.9.0",
    "tsx": "^4.20.0"
  }
}
