{
  "mcpServers": {
    "servicestudio": {
      "type": "http",
      "url": "${O11_MCP_ENDPOINT:-http://127.0.0.1:41820/mcp}"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": ["node_modules/@playwright/mcp/cli.js", "--isolated", "--headless", "--browser", "msedge"]
    }
  }
}
